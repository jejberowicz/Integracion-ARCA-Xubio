# === Base de datos (PostgreSQL) ===
DB_USER=joaco_admin
DB_PASSWORD=cambiar_esta_password
DB_NAME=gestion_contable
DB_HOST=localhost
DB_PORT=5432
# Si se define, tiene prioridad sobre las variables DB_* de arriba
# DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/gestion_contable

# === Cifrado de secretos guardados en la DB ===
# Generar con: python -m src.security.crypto generar-clave
FERNET_KEY=

# === AFIP / ARCA ===
# homologacion | produccion
AFIP_AMBIENTE=homologacion
# Carpeta base donde viven los .key y .crt de cada cliente
BASE_CERTS_PATH=./.certs

# === Xubio ===
XUBIO_API_BASE=https://xubio.com/API/1.1
XUBIO_TOKEN_URL=https://xubio.com/API/1.1/TokenEndpoint

# === Descargas de Mis Comprobantes ===
DOWNLOADS_PATH=./data/descargas
